      </style>
      <size sizing-mode='automatic' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98214' id='7' param='horz' type-v2='layout-flow' w='99058' x='471' y='893'>
            <zone h='98214' id='5' type-v2='layout-basic' w='99058' x='471' y='893'>
              <zone h='68192' id='3' name='Publisher Market Share' w='67047' x='14533' y='27344'>
                <zone-style>
